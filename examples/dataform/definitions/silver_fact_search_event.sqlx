config {
  type: "table",
  schema: "hotel_search_silver",
  name: "fact_search_event",
  tags: ["silver", "fact"]
}

-- Grain: one canonical search event.
-- Do NOT UNNEST payload.search_results here.
with raw_events as (
  select
    cast(json_value(data, '$.event_id') as string) as event_id,
    cast(json_value(data, '$.partner_id') as string) as partner_id,
    cast(json_value(data, '$.schema_version') as string) as schema_version,
    safe_cast(json_value(data, '$.ingested_at') as timestamp) as ingested_at,
    publish_time,
    safe_cast(json_value(data, '$.payload.timestamp') as timestamp) as event_timestamp,
    safe_cast(json_value(data, '$.payload.arrival_date') as date) as arrival_date,
    safe_cast(json_value(data, '$.payload.departure_date') as date) as departure_date,
    safe_cast(json_value(data, '$.payload.length_of_stay') as int64) as length_of_stay,
    upper(cast(json_value(data, '$.payload.user_country') as string)) as user_country,
    safe_cast(json_value(data, '$.payload.hotel_id') as int64) as hotel_id,
    cast(json_value(data, '$.payload.hotel_name') as string) as hotel_name,
    coalesce(cast(json_value(data, '$.payload.city') as string), 'UNKNOWN_CITY') as city,
    1 as search_count
  from hotel_search_raw.pubsub_search_events
),

deduped as (
  select *
  from raw_events
  where event_id is not null
    and partner_id is not null
    and arrival_date is not null
  qualify row_number() over (
    partition by partner_id, event_id
    order by publish_time desc
  ) = 1
)

select
  event_id,
  partner_id,
  schema_version,
  ingested_at,
  publish_time,
  event_timestamp,
  arrival_date,
  departure_date,
  length_of_stay,
  user_country,
  hotel_id,
  hotel_name,
  city,
  date(coalesce(event_timestamp, publish_time)) as search_date,
  city = 'UNKNOWN_CITY' as is_city_imputed,
  search_count
from deduped;
